pkgname=drift
pkgver=0.1.0
pkgrel=1
pkgdesc='Drift: a beautiful Apple Music player'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-webchannel' 'qt6-wayland')
optdepends=('qt6-svg: tray icon' 'pipewire: EQ and reverb' 'libpulse: following the music (parec)')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-webchannel')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/drift "$pkgdir/usr/bin/drift"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/drift.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/drift.svg"
  install -Dm644 "$startdir/drift.desktop" "$pkgdir/usr/share/applications/drift.desktop"
}
