pkgname=click
pkgver=0.1.0
pkgrel=1
pkgdesc='A beautiful mini player for Apple Music'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-webchannel' 'qt6-wayland')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-webchannel')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/click "$pkgdir/usr/bin/click"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/click.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/click.svg"
  install -Dm644 "$startdir/click.desktop" "$pkgdir/usr/share/applications/click.desktop"
}
