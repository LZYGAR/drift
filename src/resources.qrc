<RCC>
    <qresource prefix="/">
        <file alias="MainWindow.qml">MainWindow.qml</file>
        <file alias="drift.svg">../pkgbuild/drift.svg</file>
        <file alias="pod.js">pod.js</file>
        <file alias="authfix.js">authfix.js</file>
        <file alias="qwebchannel.js">qwebchannel.js</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="i18n/da.json">i18n/da.json</file>
    </qresource>
    <qresource prefix="/ClickUi">
        <file alias="qmldir">qmldir</file>
        <file alias="Wheel.qml">Wheel.qml</file>
        <file alias="Player.qml">Player.qml</file>
        <file alias="Glass.qml">Glass.qml</file>
        <file alias="Glyph.qml">Glyph.qml</file>
        <file alias="IconButton.qml">IconButton.qml</file>
        <file alias="GlassPanel.qml">GlassPanel.qml</file>
        <file alias="MeshBackground.qml">MeshBackground.qml</file>
        <file alias="shaders/mesh.frag.qsb">shaders/mesh.frag.qsb</file>
        <file alias="LiquidScrubber.qml">LiquidScrubber.qml</file>
        <file alias="AdvancedSoundStudio.qml">AdvancedSoundStudio.qml</file>
        <file alias="CommandPalette.qml">CommandPalette.qml</file>
        <file alias="LyricsView.qml">LyricsView.qml</file>
        <file alias="LiquidField.qml">LiquidField.qml</file>
        <file alias="DriftMark.qml">DriftMark.qml</file>
        <file alias="Intro.qml">Intro.qml</file>
        <file alias="shaders/liquid.frag.qsb">shaders/liquid.frag.qsb</file>
        <file alias="FullScreenLyricsView.qml">FullScreenLyricsView.qml</file>
        <file alias="shaders/fringe.frag.qsb">shaders/fringe.frag.qsb</file>
        <file alias="HeaderPlusPill.qml">HeaderPlusPill.qml</file>
        <file alias="ActionDropdown.qml">ActionDropdown.qml</file>
        <file alias="LiquidSwitch.qml">LiquidSwitch.qml</file>
        <file alias="PlayPauseGlyph.qml">PlayPauseGlyph.qml</file>
    </qresource>
</RCC>
